		"@types/node": "^26.6.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.0",
		"vite": "^8.1.2"
	},
	"dependencies": {
		"@lucide/svelte": "^1.16.0",
		"@upstash/redis": "^1.38.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.1",
